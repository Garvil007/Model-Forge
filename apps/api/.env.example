# Copy to .env for local dev (gitignored). Values below work against LocalStack (`make up`).
MF_ENVIRONMENT=local
MF_AUTH_MODE=local
MF_AWS_REGION=us-east-1
MF_AWS_ENDPOINT_URL=http://localhost:4566
MF_UPLOADS_BUCKET=mf-uploads
MF_RESULTS_BUCKET=mf-results
# Fill in after `make up` — print it with:
# aws --endpoint-url=http://localhost:4566 sqs get-queue-url --queue-name system-jobs
MF_SYSTEM_JOBS_QUEUE_URL=
MF_HF_TOKEN_KMS_KEY_ID=alias/modelforge-hf-tokens
