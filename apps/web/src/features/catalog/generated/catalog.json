    {
      "id": "d_logit",
      "technique": "distillation",
      "label": "Response-based distillation",
      "description": "A smaller student learns to match your model's output probabilities. Your model only needs to run, so any runnable format works as the teacher.",
      "accuracy": "lossy",
      "typicalImpact": "student usually within 1 to 3% of the teacher",
      "timeEstimate": "hours to days on a GPU",
      "sourceFormats": [
        "onnx",
        "tflite",
        "keras",
        "torch",
        "torchscript",
        "yolo"
