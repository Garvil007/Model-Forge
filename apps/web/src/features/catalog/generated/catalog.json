        {
          "name": "calib",
          "label": "Your calibration text",
          "type": "file",
          "accept": ".txt,.jsonl",
          "showIf": {
            "field": "dataset",
            "equals": "custom"
          }
        },
        {
          "name": "act_order",
          "label": "Activation ordering (desc_act)",
          "type": "check",
          "default": true
        }
      ]
    },
    {
      "id": "q_awq",
      "technique": "quantization",
      "label": "AWQ (activation-aware)",
