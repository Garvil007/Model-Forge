      "params": [
        {
          "name": "group",
          "label": "Group size",
          "type": "select",
          "default": "128",
          "options": [
            {
              "value": "64",
              "label": "64"
            },
            {
              "value": "128",
              "label": "128 (standard)"
            }
          ]
        },
        {
          "name": "kernel",
          "label": "Kernel format",
          "type": "select",
          "default": "gemm",
          "options": [
            {
              "value": "gemm",
              "label": "GEMM (best for batches)"
