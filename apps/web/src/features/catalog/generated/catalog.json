    {
      "id": "p_magnitude",
      "technique": "pruning",
      "label": "Magnitude pruning (unstructured)",
      "description": "Zeroes out the smallest weights anywhere in the network. Shrinks the file when stored sparse; speedups need a sparse-aware runtime.",
      "accuracy": "lossy",
      "typicalImpact": "little loss up to ~50% with fine-tuning, drops fast past 80%",
      "timeEstimate": "minutes, or hours with fine-tuning",
      "sourceFormats": [
        "torch",
        "keras",
        "safetensors",
        "onnx"
      ],
      "workerImage": "cpu-base",
      "queue": "cpu",
      "params": [
        {
          "name": "sparsity",
          "label": "Sparsity",
          "type": "range",
          "default": 50,
          "min": 10,
          "max": 95,
          "step": 5,
          "unit": "%"
        },
        {
          "name": "scope",
          "label": "Scope",
          "type": "select",
          "default": "global",
          "options": [
            {
              "value": "global",
              "label": "Global (best weights across all layers)"
            },
            {
              "value": "layer",
              "label": "Same % in every layer"
            }
          ]
        },
        {
          "name": "storage",
          "label": "Save as",
          "type": "select",
          "default": "sparse",
          "options": [
            {
              "value": "sparse",
              "label": "Sparse tensors (smaller file)"
            },
            {
              "value": "dense",
              "label": "Dense with zeros (same size, zips well)"
            }
          ]
        },
        {
          "name": "finetune",
          "label": "Fine-tune afterwards to recover accuracy",
          "type": "check",
          "default": true
        },
        {
          "name": "train_data",
          "label": "Training data",
          "type": "file",
          "help": "Images folder (zip), CSV, JSONL or Parquet. A few thousand samples is often enough for fine-tuning.",
          "accept": ".zip,.tar,.csv,.jsonl,.parquet",
          "showIf": {
            "field": "finetune",
            "equals": true
          }
        },
        {
          "name": "epochs",
          "label": "Fine-tuning epochs",
          "type": "number",
          "default": 3,
          "min": 1,
          "max": 100,
          "showIf": {
            "field": "finetune",
            "equals": true
          }
        }
