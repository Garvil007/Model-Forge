      "workerImage": "gpu-base",
      "queue": "gpu",
      "allowedFamilies": [
        "vision",
        "other"
      ],
      "params": [
        {
          "name": "student",
          "label": "Student model",
          "type": "select",
          "default": "half_width",
          "options": [
            {
              "value": "half_width",
              "label": "Same design, half the width (~25% of parameters)"
            },
            {
              "value": "half_depth",
              "label": "Same design, half the depth (~50%)"
            },
            {
              "value": "compact",
              "label": "Compact preset (MobileNet / TinyBERT style, ~15%)"
            },
            {
              "value": "custom",
              "label": "Upload my own student"
            }
          ]
        },
        {
          "name": "student_file",
          "label": "Student architecture",
          "type": "file",
          "accept": ".py,.onnx,.keras,.pt",
          "showIf": {
