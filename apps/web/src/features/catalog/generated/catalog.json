{
  "techniques": [
    {
      "id": "quantization",
      "name": "Quantization",
      "tag": "Fewer bits per weight",
      "mechanism": "Lowers bit-precision (e.g. FP32 to INT8)",
      "hardwareImpact": "Drastically drops RAM; accelerates CPU/NPU",
      "complexity": "Low to medium",
      "bars": [
        1,
        0.5,
        0
      ]
    },
    {
      "id": "pruning",
      "name": "Pruning",
      "tag": "Remove weights",
      "mechanism": "Deletes less impactful weights or channels",
      "hardwareImpact": "Shrinks file size; accelerates structured execution",
      "complexity": "Medium, needs fine-tuning",
      "bars": [
        1,
        1,
        0
      ]
    },
    {
      "id": "distillation",
      "name": "Knowledge distillation",
      "tag": "Train a smaller copy",
      "mechanism": "Trains a smaller model to copy a larger one",
      "hardwareImpact": "Creates a native, lightweight architecture",
      "complexity": "High, needs retraining",
      "bars": [
        1,
        1,
        1
      ]
    },
    {
      "id": "lowrank",
      "name": "Low-rank factorization",
      "tag": "Split big matrices",
      "mechanism": "Splits massive matrices into smaller sub-matrices",
      "hardwareImpact": "Speeds up mathematical operations",
      "complexity": "Medium",
      "bars": [
        1,
        1,
        0
      ]
    }
  ],
  "operations": [
    {
      "id": "q_fp16",
      "technique": "quantization",
      "label": "FP16 (half precision)",
      "description": "Stores weights as 16-bit floats. The safest first step for any model.",
      "accuracy": "near-lossless",
      "typicalImpact": "under 0.1% accuracy change",
      "timeEstimate": "seconds",
      "sourceFormats": [
        "onnx",
        "torch",
        "torchscript",
        "keras",
        "safetensors",
        "yolo"
      ],
      "workerImage": "cpu-base",
      "queue": "cpu",
      "requiredBitWidth": 32
    },
    {
      "id": "q_bf16",
      "technique": "quantization",
      "label": "BF16 (brain float)",
      "description": "16-bit with FP32's range. The standard format for training and serving LLMs.",
      "accuracy": "near-lossless",
      "typicalImpact": "under 0.1% accuracy change",
      "timeEstimate": "seconds",
      "sourceFormats": [
        "torch",
        "safetensors"
      ],
      "workerImage": "cpu-base",
      "queue": "cpu",
      "requiredBitWidth": 32
    },
    {
      "id": "q_int8_dyn",
      "technique": "quantization",
      "label": "INT8 dynamic",
      "description": "8-bit weights, activations quantized on the fly. No data needed. Works best on transformers and RNNs.",
      "accuracy": "lossy",
      "typicalImpact": "0.5 to 2% on CNNs, less on transformers",
      "timeEstimate": "under a minute",
      "sourceFormats": [
        "onnx",
        "torch",
        "torchscript",
        "keras"
      ],
      "workerImage": "cpu-base",
      "queue": "cpu"
    },
    {
      "id": "q_int8_static",
      "technique": "quantization",
      "label": "INT8 static (calibrated)",
      "description": "Weights and activations in 8-bit, using sample inputs to pick the ranges. Fastest option on CPUs, phones and NPUs.",
      "accuracy": "lossy",
      "typicalImpact": "usually under 1% with good calibration data",
      "timeEstimate": "1 to 10 minutes",
      "sourceFormats": [
        "onnx",
        "torch",
        "torchscript",
        "keras",
        "yolo"
      ],
      "workerImage": "cpu-base",
      "queue": "cpu",
      "params": [
        {
          "name": "calib",
          "label": "Calibration inputs",
          "type": "file",
          "help": "100 to 1,000 real inputs, e.g. a zip of images. No labels needed.",
          "required": true,
          "accept": ".zip,.npz,.npy"
        },
        {
          "name": "samples",
          "label": "Samples to use",
          "type": "range",
          "default": 300,
          "min": 50,
          "max": 1000,
          "step": 50
        },
        {
          "name": "per_channel",
          "label": "Per-channel weight scales (more accurate)",
          "type": "check",
          "default": true
        },
        {
          "name": "method",
          "label": "Range estimation",
          "type": "select",
          "default": "minmax",
          "options": [
            {
              "value": "minmax",
              "label": "Min/max"
            },
            {
              "value": "entropy",
              "label": "Entropy (KL divergence)"
            },
            {
              "value": "percentile",
              "label": "Percentile 99.99%"
            }
          ]
        }
      ]
    },
    {
      "id": "q_gguf",
      "technique": "quantization",
      "label": "GGUF (llama.cpp)",
      "description": "Block-wise quantization for llama.cpp, Ollama and LM Studio. Runs LLMs on laptops and CPUs.",
      "accuracy": "lossy",
      "typicalImpact": "depends on the type below",
      "timeEstimate": "2 to 10 minutes",
      "sourceFormats": [
        "safetensors",
        "torch"
      ],
      "workerImage": "gpu-base",
      "queue": "cpu",
      "allowedFamilies": [
        "llm"
      ],
      "params": [
        {
          "name": "qtype",
          "label": "Quantization type",
          "type": "select",
          "default": "Q4_K_M",
          "options": [
            {
              "value": "Q8_0",
              "label": "Q8_0, 8.5 bits, almost lossless"
            },
            {
              "value": "Q6_K",
              "label": "Q6_K, 6.6 bits, very high quality"
            },
            {
              "value": "Q5_K_M",
              "label": "Q5_K_M, 5.7 bits, high quality"
            },
            {
              "value": "Q4_K_M",
              "label": "Q4_K_M, 4.8 bits, recommended balance"
            },
            {
              "value": "Q3_K_M",
              "label": "Q3_K_M, 3.9 bits, small, noticeable loss"
            },
            {
              "value": "Q2_K",
              "label": "Q2_K, 3.4 bits, smallest, large loss"
            }
          ]
        },
        {
          "name": "imatrix",
          "label": "Use an importance matrix (better quality below 5 bits)",
          "type": "check",
          "default": true
        },
        {
          "name": "imatrix_text",
          "label": "Calibration text",
          "type": "file",
          "help": "Optional. Uses a general English sample if left empty.",
          "accept": ".txt,.jsonl",
          "showIf": {
            "field": "imatrix",
            "equals": true
          }
        }
      ]
    },
    {
      "id": "q_gptq",
      "technique": "quantization",
      "label": "GPTQ",
      "description": "Quantizes weights layer by layer while correcting the error it introduces. For GPU serving with vLLM, TGI or Transformers.",
      "accuracy": "lossy",
      "typicalImpact": "about 2 to 4% perplexity increase at 4-bit",
      "timeEstimate": "10 to 60 minutes on a GPU",
      "sourceFormats": [
        "safetensors",
        "torch"
      ],
      "workerImage": "gpu-base",
      "queue": "gpu",
      "allowedFamilies": [
        "llm"
      ],
      "params": [
        {
          "name": "bits",
          "label": "Bits",
          "type": "select",
          "default": "4",
          "options": [
            {
              "value": "8",
              "label": "8-bit"
            },
            {
              "value": "4",
              "label": "4-bit"
            },
            {
              "value": "3",
              "label": "3-bit"
            }
          ]
        },
        {
          "name": "group",
          "label": "Group size",
          "type": "select",
          "default": "128",
          "options": [
            {
              "value": "32",
              "label": "32 (more accurate, larger)"
            },
            {
              "value": "64",
              "label": "64"
            },
            {
              "value": "128",
              "label": "128 (standard)"
            }
          ]
        },
        {
          "name": "dataset",
          "label": "Calibration dataset",
          "type": "select",
          "default": "wikitext2",
          "options": [
            {
              "value": "wikitext2",
              "label": "WikiText-2"
            },
            {
              "value": "c4",
              "label": "C4"
            },
            {
              "value": "custom",
              "label": "Upload my own"
            }
          ]
