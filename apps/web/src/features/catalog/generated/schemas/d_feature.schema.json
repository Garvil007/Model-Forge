{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature-based distillation",
  "type": "object",
  "properties": {
    "student": {
      "type": "string",
      "enum": [
        "half_width",
        "half_depth",
        "custom"
      ]
    },
    "student_file": {
      "type": "string",
      "description": "Uploaded object key or filename"
    },
    "layers": {
      "type": "string",
      "enum": [
        "last",
        "stages",
        "auto"
      ]
    },
    "train_data": {
      "type": "string",
      "description": "Uploaded object key or filename"
    },
    "epochs": {
      "type": "number",
      "minimum": 1,
      "maximum": 500
    }
  },
  "required": [
    "train_data"
  ]
}