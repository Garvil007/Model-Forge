{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TensorRT engine",
  "type": "object",
  "properties": {
    "precision": {
      "type": "string",
      "enum": [
        "fp32",
        "fp16",
        "int8"
      ]
    },
    "calib": {
      "type": "string",
      "description": "Uploaded object key or filename"
    },
    "gpu": {
      "type": "string",
      "enum": [
        "t4",
        "l4",
        "a100",
        "h100",
        "jetson"
      ]
    }
  }
}