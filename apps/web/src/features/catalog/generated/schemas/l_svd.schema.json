{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Truncated SVD (linear layers)",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "energy",
        "fraction"
      ]
    },
    "energy": {
      "type": "number",
      "minimum": 80,
      "maximum": 99,
      "multipleOf": 1
    },
    "rank": {
      "type": "number",
      "minimum": 5,
      "maximum": 75,
      "multipleOf": 5
    },
    "layers": {
      "type": "string",
      "enum": [
        "mlp",
        "attn"
      ]
    },
    "finetune": {
      "type": "boolean"
    },
    "train_data": {
      "type": "string",
      "description": "Uploaded object key or filename"
    },
    "epochs": {
      "type": "number",
      "minimum": 1,
      "maximum": 100
    }
  }
}