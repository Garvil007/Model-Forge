{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One-shot LLM pruning (Wanda / SparseGPT)",
  "type": "object",
  "properties": {
    "algo": {
      "type": "string",
      "enum": [
        "wanda",
        "sparsegpt"
      ]
    },
    "pattern": {
      "type": "string",
      "enum": [
        "unstructured",
        "2:4"
      ]
    },
    "sparsity": {
      "type": "number",
      "minimum": 10,
      "maximum": 70,
      "multipleOf": 5
    }
  }
}