{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tucker / CP decomposition (conv layers)",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "tucker2",
        "cp"
      ]
    },
    "rank": {
      "type": "number",
      "minimum": 10,
      "maximum": 75,
      "multipleOf": 5
    },
    "finetune": {
      "type": "boolean"
    },
    "train_data": {
      "type": "string",
      "description": "Uploaded object key or filename"
    },
    "epochs": {
      "type": "number",
      "minimum": 1,
      "maximum": 100
    }
  }
}