{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog",
  "type": "object",
  "properties": {
    "techniques": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Technique"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Operation"
      }
    }
  },
  "required": [
    "techniques",
    "operations"
  ],
  "$defs": {
    "Technique": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "mechanism": {
          "type": "string"
        },
        "hardwareImpact": {
          "type": "string"
        },
        "complexity": {
          "type": "string"
        },
        "bars": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "id",
        "name",
        "tag",
        "mechanism",
        "hardwareImpact",
        "complexity",
        "bars"
      ]
    },
    "ParamOption": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ]
    },
    "ShowIf": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "equals": {}
      },
      "required": [
        "field",
        "equals"
      ]
    },
    "Param": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "select",
            "range",
            "check",
            "number",
            "text",
            "file"
          ]
        },
        "default": {},
        "help": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParamOption"
          }
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "accept": {
          "type": "string"
        },
        "onlyFor": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "showIf": {
          "$ref": "#/$defs/ShowIf"
        }
      },
      "required": [
        "name",
        "label",
        "type"
      ]
    },
    "Operation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "technique": {
          "type": "string",
          "enum": [
            "quantization",
            "pruning",
            "distillation",
            "lowrank",
            "convert"
          ]
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "accuracy": {
          "type": "string",
          "enum": [
            "lossless",
            "near-lossless",
            "lossy"
          ]
        },
        "typicalImpact": {
          "type": "string"
        },
        "timeEstimate": {
          "type": "string"
        },
        "sourceFormats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workerImage": {
          "type": "string"
        },
        "queue": {
          "type": "string",
          "enum": [
            "cpu",
            "gpu"
          ]
        },
        "allowedFamilies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredBitWidth": {
          "type": "number"
        },
        "targetFormat": {
          "type": "string"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Param"
          }
        }
      },
      "required": [
        "id",
        "technique",
        "label",
        "description",
        "accuracy",
        "typicalImpact",
        "timeEstimate",
        "sourceFormats",
        "workerImage",
        "queue"
      ]
    }
  }
}