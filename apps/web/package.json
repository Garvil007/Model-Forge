{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ignore-pattern storybook-static --ignore-pattern .screenshots && npm run lint:css",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --check .",
    "test": "vitest run",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "shot": "node scripts/shot.mjs",
    "shot-stories": "node scripts/shot-stories.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-mcp": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.4",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/ui": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "playwright": "latest",
    "prettier": "^3.9.10",
    "storybook": "^10.6.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
